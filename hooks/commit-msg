#!/usr/bin/env python3
"""Validate the proposed Git commit message."""

import argparse
from pathlib import Path
import re
import subprocess


PICTOGRAPH = (
    r"[\u00a9\u00ae\u203c\u2049\u2122\u2139\u2194-\u2199\u21a9-\u21aa"
    r"\u231a-\u231b\u2328\u23cf\u23e9-\u23fa\u24c2\u25aa-\u25ab\u25b6\u25c0"
    r"\u25fb-\u25fe\u2600-\u26ff\u2700-\u27bf\u2934-\u2935\u2b05-\u2b07"
    r"\u2b1b-\u2b1c\u2b50\u2b55\u3030\u303d\u3297\u3299"
    r"\U0001f170-\U0001f251\U0001f300-\U0001f6ff\U0001f7e0-\U0001f7eb"
    r"\U0001f7f0\U0001f900-\U0001faff]"
    r"\ufe0f?[\U0001f3fb-\U0001f3ff]?"
)
EMOJI = re.compile(
    rf"(?:{PICTOGRAPH}(?:\u200d{PICTOGRAPH})*"
    r"|[\U0001f1e6-\U0001f1ff]{2}|[0-9#*]\ufe0f?\u20e3)"
)
SUBJECT = re.compile(r"[a-z][a-z0-9-]*\([A-Za-z0-9][A-Za-z0-9._/-]*\): (.+)")
LATIN = re.compile(r"[A-Za-z]")
HAN = re.compile(r"[\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff\U00020000-\U000323af]")
SUMMARY_PREFIX = "中文总结："
TRAILER = re.compile(r"[A-Za-z][A-Za-z0-9-]*: \S.*")
CO_AUTHOR = re.compile(r"Co-authored-by: [^<>\n]+ <[^<>\s@]+@[^<>\s@]+>")
SCISSORS = b"------------------------ >8 ------------------------"


def git_stripspace(option, message):
    return subprocess.run(
        ["git", "stripspace", option],
        input=message,
        stdout=subprocess.PIPE,
        check=True,
    ).stdout


def read_message(path):
    message = path.read_bytes()
    if SCISSORS in message:
        scissors = git_stripspace("--comment-lines", SCISSORS + b"\n").rstrip(b"\n")
        lines = message.splitlines(keepends=True)
        for index, line in enumerate(lines):
            if line.rstrip(b"\r\n") == scissors:
                message = b"".join(lines[:index])
                break
    return git_stripspace("--strip-comments", message).decode("utf-8").rstrip("\n")


def is_trailer_block(paragraph):
    return all(TRAILER.fullmatch(line) for line in paragraph.splitlines())


def validate(message):
    paragraphs = message.split("\n\n")
    emoji, _, subject = paragraphs[0].partition(" ")
    match = SUBJECT.fullmatch(subject)
    if not EMOJI.fullmatch(emoji) or not match:
        raise ValueError("Use: emoji type(scope): English subject")
    if not LATIN.search(match[1]) or HAN.search(match[1]):
        raise ValueError("Write the subject in English.")

    body = paragraphs[1:]
    if body and is_trailer_block(body[-1]):
        for line in body.pop().splitlines():
            if line.lower().startswith("co-authored-by:") and not CO_AUTHOR.fullmatch(line):
                raise ValueError("Use: Co-authored-by: Name <email@example.com>")

    details = "\n\n".join(body[:-1])
    if not LATIN.search(details) or HAN.search(details):
        raise ValueError("Add English details in a separate paragraph after the subject.")

    summary = body[-1]
    if (
        "\n" in summary
        or not summary.startswith(SUMMARY_PREFIX)
        or not HAN.search(summary[len(SUMMARY_PREFIX):])
    ):
        raise ValueError("End the body with one Chinese summary line: 中文总结：...")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("message_file", type=Path)
    args = parser.parse_args()
    try:
        validate(read_message(args.message_file))
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        parser.exit(1, f"commit-msg: {error}\n")


if __name__ == "__main__":
    main()
